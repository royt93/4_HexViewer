<?xml version="1.0" encoding="utf-8"?>
<!-- Glass morphism background for dialogs - Dark theme (Android < 12 fallback) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent dark background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3000000" /><!-- 70% black -->
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Subtle gradient overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A6F4376"
                android:centerColor="#0D6F4376"
                android:endColor="#006F4376" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Border stroke -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" /><!-- 20% white border -->
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
