<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App title -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="Android Hex Viewer (Fork)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- About this fork -->
            <TextView
                android:id="@+id/aboutFork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="This project is a fork of HexViewer, an open-source Android application for viewing and editing files in hexadecimal and plain text.\n\nThe original project is licensed under the GNU General Public License v3.0 or later (GPLv3+)."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <!-- Modifications -->
            <TextView
                android:id="@+id/modificationsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="📌 Modifications in this fork:"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modificationsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/changelog_text"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- Credits -->
            <TextView
                android:id="@+id/creditsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/credits_attribution"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/creditsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="Original author: Keidan\nOriginal project: HexViewer\nContributors: See the original repository for full contributor list.\nAdditional modifications by: Roy"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- License -->
            <TextView
                android:id="@+id/licenseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="📜 License"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/licenseContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="This project is licensed under the terms of the GNU General Public License v3.0 or later. You are free to use, modify, and redistribute this software under the same license."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- Source code link -->
            <TextView
                android:id="@+id/sourceCodeLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="🔗 Source Code"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/ripple_surface"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
